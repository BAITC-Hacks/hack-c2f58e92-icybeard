{
  "realm": "darumen",
  "displayName": "Darumen Health",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "darumen",
  "emailTheme": "darumen",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "kk"
  ],
  "defaultLocale": "ru",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpPolicyCodeReusable": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "actionTokenGeneratedByUserLifespan": 3600,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging",
    "email"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "UPDATE_PASSWORD",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "RESET_PASSWORD",
    "SEND_RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "SEND_RESET_PASSWORD_ERROR",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT"
  ],
  "adminEventsEnabled": false,
  "smtpServer": {
    "host": "${SMTP_HOST:mailpit}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:noreply@darumen.kz}",
    "fromDisplayName": "Darumen Health",
    "replyTo": "help@darumen.kz",
    "replyToDisplayName": "Поддержка Darumen",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}",
    "starttls": "${SMTP_STARTTLS:false}",
    "ssl": "${SMTP_SSL:false}"
  },
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "Гражданин · Азамат — свой маршрут, клейм iin"
      },
      {
        "name": "doctor",
        "description": "Врач ПМСП · МСАК дәрігері — клеймы region_kato, mo_code"
      },
      {
        "name": "org_admin",
        "description": "Администратор организации · Ұйым әкімшісі — обязателен клейм mo_code (прежняя роль chief)"
      },
      {
        "name": "regulator",
        "description": "Регулятор (Минздрав) · Реттеуші (ДСМ) — вся страна"
      },
      {
        "name": "steward",
        "description": "Стюард данных · Деректер стюарды — загрузки и качество данных"
      },
      {
        "name": "auditor",
        "description": "Аудитор · Аудитор — журналы и аудит"
      },
      {
        "name": "admin",
        "description": "Администратор системы · Жүйе әкімшісі — все разрешения"
      }
    ]
  },
