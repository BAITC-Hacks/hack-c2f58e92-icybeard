# Стенд хакатона GovTech: общий для всех команд VPS организаторов (Ubuntu 22.04). TLS для icybeard.govtech-kz.com
# терминирует Caddy организаторов и проксирует на порт 8014 этого же сервера (WEB_PORT=8014 в .env.govtech).
# Секретов здесь нет: логин и пароль команды — только у команды, вход по ssh-ключу (разово: ssh-copy-id, docs/deploy.md).
DEPLOY_HOST=icybeard@82.115.43.223
DEPLOY_PATH=/home/icybeard/darumen
DEPLOY_ENV_FILE=infra/deploy/.env.govtech
PUBLIC_URL=https://icybeard.govtech-kz.com
# Docker на VPS rootless, у каждой команды свой демон (проверено 28.09): чистка трогает только наши образы и кэш,
# а место на общем диске освобождает для всех
DEPLOY_PRUNE=1
# Образы собирает CI (GHCR), выкатывает release.sh: сборка на VPS не помещается в квоту 4 ГБ и в ~1,8 ГБ памяти
DEPLOY_MODE=ci
# на случай DEPLOY_MODE=build: образы по одному, чтобы не уводить VPS в swap
DEPLOY_SEQUENTIAL_BUILD=1
