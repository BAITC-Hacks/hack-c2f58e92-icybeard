# Секреты продового стенда: на VM — /srv/darumen/.env (chmod 600), единственное хранилище секретов стенда.
# CD (release.yml → release.sh) этот файл не читает наружу и не перезаписывает; `make deploy` копирует сюда
# локальный infra/deploy/.env.prod (в git не попадает). Длинные случайные значения: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me-long-random
# Роль и БД keycloak в том же Postgres (создаёт и обновляет сервис db-init; смена значения применяется при следующем up)
KEYCLOAK_DB_PASSWORD=change-me-long-random
# Администратор Keycloak (консоль https://dc.jurek.kz/auth/admin/): создаётся при первом старте на пустой БД, им же
# входит realm-sync (keycloak-config-cli). Сменили пароль admin в консоли — поменяйте и здесь, иначе realm-sync упадёт.
KEYCLOAK_ADMIN_PASSWORD=change-me-long-random
# Секрет служебного клиента darumen-admin (service account для API: пользователи, роли, события входа). Обязателен.
# realm-sync применяет смену секрета к клиенту, api читает то же значение — меняются вместе одним релизом.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-long-random
# Почта Keycloak (сброс пароля, уведомления безопасности). Без SMTP_HOST письма не уходят, вход работает.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@darumen.kz
SMTP_AUTH=true
SMTP_STARTTLS=true
# SMTP_SSL не задавайте для порта 587: Keycloak шифрует через STARTTLS, API (Mail__Smtp__EnableSsl) по умолчанию тоже.
# SMTP_SSL=true — только для порта 465 (неявный TLS в Keycloak; SmtpClient API такой режим не поддерживает).
DEEPSEEK_API_KEY=sk-...
# Провайдер для Insight (вопросы к данным) и черновиков скрайба: deepseek | openai | ollama
LLM_PROVIDER=deepseek
INSIGHT_MODEL=deepseek-chat
INSIGHT_BASE_URL=https://api.deepseek.com/v1
SCRIBE_MODEL=deepseek-chat
PUBLIC_ORIGIN=https://dc.jurek.kz

# --- Пути и образы: release.sh и deploy.sh выставляют их сами, здесь — для ручного `docker compose` на VM ---
LAKEHOUSE_DIR=/srv/darumen/lakehouse
# Реестр образов (GHCR, только нижний регистр) и тег: vX.Y.Z — образы CD из GHCR, local — собранные `make deploy` на VM
# REGISTRY=ghcr.io/baitc-hacks/hack-c2f58e92-icybeard
# IMAGE_TAG=local

# --- Бэкапы (сервис backup, prodrigestivill/postgres-backup-local) ---
# Каталог дампов на хосте; владелец — BACKUP_UID:BACKUP_GID (пользователь deploy = 1000:1000)
BACKUP_DIR=/srv/darumen/backups
BACKUP_UID=1000
BACKUP_GID=1000
# Расписание (cron или @daily, время Asia/Almaty) и сколько хранить дневных/недельных/месячных дампов
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
