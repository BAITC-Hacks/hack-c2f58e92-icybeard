# Скопировать в .env и заполнить. Секреты в git не попадают.
DATASETS_DIR=DataSets
POSTGRES_CONNECTION=Host=localhost;Database=darumen;Username=darumen;Password=darumen
CLICKHOUSE_URL=http://darumen:darumen@localhost:8123/darumen
KAFKA_BOOTSTRAP=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=darumen
MINIO_SECRET_KEY=darumen123
MLFLOW_TRACKING_URI=http://localhost:5001
KEYCLOAK_URL=http://localhost:8080
# Модель для Insight и черновиков скрайба. По умолчанию локальная Ollama: darumen-qwen3.8:27b (make ollama-model поверх qwen3.8:27b, контекст 16k), ключ не нужен.
# Провайдер для скрайба: DARUMEN_LLM_PROVIDER=ollama|deepseek|openai, адрес DARUMEN_LLM_BASE_URL, модель DARUMEN_SCRIBE_MODEL.
# Для API то же в appsettings Insight:Provider/Model/BaseUrl (или переменные Insight__Provider и т. д.).
DARUMEN_LLM_PROVIDER=ollama
DARUMEN_SCRIBE_MODEL=darumen-qwen3.8:27b
DEEPSEEK_API_KEY=
# Альтернативы: OPENAI_API_KEY с Insight:Provider=openai или ANTHROPIC_API_KEY с Insight:Provider=anthropic
ANTHROPIC_API_KEY=

# Docker: адрес Ollama для контейнеров (на macOS Ollama работает на хосте), режим входа API
# (веб всегда ходит в Keycloak), папка с наборами для профиля pipeline
OLLAMA_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=darumen-qwen3.8:27b
API_AUTH_MODE=keycloak
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Keycloak в Docker: секрет служебного клиента darumen-admin (по умолчанию darumen-admin-dev-secret) и корень веба
# для ссылок со страницы входа (по умолчанию http://localhost:5173/). Письма уходят в Mailpit: http://localhost:8025
# KEYCLOAK_ADMIN_CLIENT_SECRET=darumen-admin-dev-secret
# DARUMEN_WEB_URL=http://localhost:5173/
DATASETS_DIR=../DataSets
