# Вход — Keycloak (OIDC, PKCE): realm darumen, публичный клиент darumen-web; демо-пользователи в infra/keycloak/darumen-realm.json
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=darumen
VITE_KEYCLOAK_CLIENT=darumen-web
# Кнопка «Войти через eGov mobile» флагом сборки не управляется: доступность eGov приходит из API
# (GET /api/v1/public/service-status, Services:Egov:Endpoint), см. docs/egov-auth.md
# База API; пусто = тот же origin (в dev работает прокси Vite на :8000)
VITE_API_BASE=
# Стиль карты MapLibre (векторные тайлы без ключа)
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Стиль тайлов для тёмной темы (необязательно); пусто — светлый стиль затемняется CSS-фильтром
VITE_MAP_STYLE_DARK=
