# Режим входа: headers (роль выбирается в шапке, заголовки X-Actor/X-Role) или keycloak (OIDC PKCE)
VITE_AUTH_MODE=headers
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=darumen
VITE_KEYCLOAK_CLIENT=darumen-web
# База API; пусто = тот же origin (в dev работает прокси Vite на :8000)
VITE_API_BASE=
# Стиль карты MapLibre (векторные тайлы без ключа)
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
