<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: системный сплэш рисует иконку приложения сам, и знак показывался дважды (иконка, потом заставка
         Flutter). Иконку сплэша делаем прозрачной, фон — холст Палитры C (#F5F6F8); знак собирает DarumenIntro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/darumen_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/darumen_canvas</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
