{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=darumen;Username=darumen;Password=darumen",
    "ClickHouse": "Host=localhost;Port=8123;Database=darumen;Username=darumen;Password=darumen"
  },
  "ModelServices": {
    "Address": "http://localhost:50051",
    "TimeoutSeconds": 5
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "Mode": "keycloak",
    "Authority": "http://localhost:8080/realms/darumen",
    "Audience": "darumen-api",
    "RequireHttps": false
  },
  "Messaging": {
    "Mode": "kafka",
    "BootstrapServers": "localhost:29092",
    "SchemaRegistry": "http://localhost:8081",
    "Schema": "wolverine",
    "ConsumerGroup": "darumen-api"
  }
}
